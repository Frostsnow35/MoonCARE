# MoonCARE server deployment environment template.
#
# Copy this file to `.env` on the server BEFORE running `bash deploy.sh`:
#   cp .env.example .env && chmod 600 .env && vi .env
#
# Every value marked "REPLACE" must be filled in. `deploy.sh` will generate
# DB_PASSWORD and SECRET_KEY automatically if you leave them blank, but for a
# real deployment you should set them yourself and keep them stable.

# ===== Host binding =====
# Direct phone access without Nginx (simplest "先用起来" mode):
#   APP_BIND_ADDR=0.0.0.0 and open TCP port 18000 in the firewall, then visit
#   http://<server-ip>:18000 from the phone browser or set it as the APK server.
# Safer setup (recommended before exposing publicly):
#   APP_BIND_ADDR=127.0.0.1 + Nginx reverse proxy on port 80/443
#   (deploy/nginx/mooncare-ip.conf) which also proxies WebSocket/SSE.
APP_BIND_ADDR=0.0.0.0
APP_PORT=18000
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_READY_TIMEOUT_SECONDS=90

# ===== Database =====
# Must be a strong random string. Keep it identical across redeploys so the
# existing PostgreSQL volume stays readable. deploy.sh auto-generates if blank.
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ===== Secrets =====
# Long random string; protects JWT + email-code hashes. Keep it stable.
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_PASSWORD_MIN_LENGTH=8

# ===== Runtime mode =====
# MUST be false on a public server. When true, a debug test account is enabled
# and log-mode email codes are allowed.
DEBUG=false
RUN_DB_MIGRATIONS=false

# ===== Email verification (registration / password reset) =====
# Delivery mode: "smtp" for real emails, "log" only for local dev (DEBUG=true).
AUTH_EMAIL_DELIVERY_MODE=smtp
AUTH_EMAIL_CODE_TTL_MINUTES=10
AUTH_EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=465
SMTP_USERNAME=REPLACE_WITH_SENDER_EMAIL
SMTP_PASSWORD=REPLACE_WITH_SMTP_AUTH_CODE
SMTP_FROM_EMAIL=REPLACE_WITH_SENDER_EMAIL
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# ===== LLM provider (AI chat) =====
# Supported providers: nvidia, openai, zai, vllm, accelerated.
# With an empty NVIDIA_API_KEY the chat still works but returns a clear
# "LLM 未配置" fallback instead of crashing. Fill in a real key to enable AI.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=deepseek-ai/deepseek-v4-flash

# Optional alternate providers (uncomment to use):
# OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-3.5-turbo
# ZAI_API_KEY=REPLACE_WITH_ZAI_API_KEY
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
# ZAI_MODEL_NAME=glm-5.1

# ===== Feature flags =====
MEMORY_SYSTEM_ENABLED=true
# Keep semantic cache off unless you also run a Redis container.
SEMANTIC_CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
# Awareness memory needs a separately deployed service; keep off by default.
AWARENESS_MEMORY_ENABLED=false
AWARENESS_BASE_URL=http://host.docker.internal:37800

# ===== HTTP / streaming =====
HTTP2_ENABLED=true
STREAMING_ENABLED=true
ENABLE_GZIP_COMPRESSION=true

# ===== Docker build mirrors (for slow networks) =====
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
PIP_DEFAULT_TIMEOUT=300
PIP_RETRIES=10
