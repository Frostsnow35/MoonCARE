# MoonCARE Docker + server deployment example
# Copy to .env on the server and replace every placeholder before production use.
# Do not commit real secrets, database passwords, LLM API keys, or JWT keys.

# Host port bindings. Defaults bind to localhost so the public entry should be a reverse proxy.
APP_BIND_ADDR=127.0.0.1
APP_PORT=8000
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PORT=5432

# Operational backup policy for server scripts. The app does not read these directly yet.
BACKUP_DIR=/www/backup
BACKUP_RETENTION_DAYS=30

# Required database secret for docker-compose.yml.
DB_PASSWORD=replace_with_strong_postgres_password

# Required JWT signing secret. Generate a long random value for each environment.
SECRET_KEY=replace_with_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_EMAIL_CODE_TTL_MINUTES=10
AUTH_EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5

# Email verification delivery. Use `log` only for local DEBUG=true development.
# Production should keep smtp and configure SMTP_*.
# For 163 Mail, use port 465 with SSL. The SMTP_FROM_EMAIL must equal SMTP_USERNAME.
AUTH_EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=replace_with_sender_163_email
SMTP_PASSWORD=replace_with_163_smtp_authorization_code
SMTP_FROM_EMAIL=replace_with_sender_163_email
SMTP_USE_TLS=false
SMTP_USE_SSL=true

# Runtime mode.
DEBUG=false
# 开发模式下支持空表单登录自动创建测试用户
# 测试用户默认配置:
#   邮箱: test@mooncare.local
#   密码: test123456
MEMORY_SYSTEM_ENABLED=true

# LLM provider: nvidia, openai, vllm, accelerated, or zai.
LLM_PROVIDER=nvidia

# Z.AI / GLM provider.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL_NAME=glm-5.1

# NVIDIA provider.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=deepseek-ai/deepseek-v4-flash

# OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-3.5-turbo

# Local or internal OpenAI-compatible inference endpoints.
VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_API_KEY=vllm-local
VLLM_MODEL_NAME=meta/llama-3.2-3b-instruct
ACCELERATED_LLM_BASE_URL=http://host.docker.internal:30000/v1
ACCELERATED_LLM_API_KEY=accelerated-local
ACCELERATED_LLM_MODEL_NAME=glm-5.1

# Latency controls. Keep bounded so chat has timeout fallback behavior.
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_WRITE_TIMEOUT_SECONDS=20
LLM_POOL_TIMEOUT_SECONDS=10
CHAT_AGENT_REPLY_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=0
LLM_TRUST_ENV_PROXY=false

# Optional Redis semantic cache. Keep disabled unless Redis is deployed and isolated.
REDIS_URL=
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_TTL_HOURS=24
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.85

# Optional Awareness Local memory. Production needs a separate multi-user isolation review.
AWARENESS_MEMORY_ENABLED=false
AWARENESS_BASE_URL=http://host.docker.internal:37800
AWARENESS_MCP_PATH=/mcp
AWARENESS_TIMEOUT_SECONDS=3
AWARENESS_RECALL_LIMIT=5
AWARENESS_SOURCE=mooncare-backend

# HTTP and streaming behavior.
HTTP2_ENABLED=true
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_TIMEOUT_SECONDS=60
STREAMING_ENABLED=true
FIRST_TOKEN_TIMEOUT_SECONDS=20
ENABLE_GZIP_COMPRESSION=true
