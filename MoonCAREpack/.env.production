# MoonCARE production defaults for Docker Compose.

# SQLite data is persisted by the sqlite-data Docker volume.
DATABASE_URL=sqlite:////app/backend/data/mooncare.db

# Replace before public deployment.
SECRET_KEY=your-production-secret-key-min-32-chars

# LLM provider: nvidia, openai, vllm, accelerated, or zai.
LLM_PROVIDER=nvidia

# NVIDIA API settings when LLM_PROVIDER=nvidia.
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=z-ai/glm-5.1

# OpenAI-compatible settings when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-3.5-turbo

# Redis and semantic cache.
REDIS_URL=redis://redis:6379
SEMANTIC_CACHE_ENABLED=false

# HTTP and streaming settings.
HTTP2_ENABLED=true
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_TIMEOUT_SECONDS=60
STREAMING_ENABLED=true
ENABLE_GZIP_COMPRESSION=true
