# MoonCARE backend environment example.
# Production values should be injected through Docker/server secrets or a protected .env file.

# ===== 数据库配置 =====
# 生产环境必须使用 PostgreSQL，示例：
# DATABASE_URL=postgresql://user:password@host:5432/mooncare
# 本地开发可使用 SQLite
DATABASE_URL=sqlite:///./healthai.db

# ===== 安全配置 =====
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== LLM 提供商配置 =====
# 可选值: nvidia, openai, vllm, accelerated, zai
LLM_PROVIDER=nvidia

# NVIDIA API 配置（当 LLM_PROVIDER=nvidia 时）
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL_NAME=z-ai/glm-5.1

# OpenAI API 配置（当 LLM_PROVIDER=openai 时）
OPENAI_API_KEY=your-openai-api-key
MODEL_NAME=gpt-3.5-turbo

# Z.AI/智谱 API 配置（当 LLM_PROVIDER=zai 时）
ZAI_API_KEY=your-zai-api-key
ZAI_MODEL_NAME=glm-5.1

# vLLM 本地部署配置（当 LLM_PROVIDER=vllm 时）
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=vllm-local
VLLM_MODEL_NAME=meta/llama-3.2-3b-instruct

# 通用加速端点（当 LLM_PROVIDER=accelerated 时）
ACCELERATED_LLM_BASE_URL=http://localhost:30000/v1
ACCELERATED_LLM_API_KEY=accelerated-local
ACCELERATED_LLM_MODEL_NAME=glm-5.1

# ===== Redis 配置（语义缓存，可选）=====
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=100

# ===== 性能优化配置 =====
SEMANTIC_CACHE_ENABLED=false          # 生产环境如无 Redis 请保持 false
SEMANTIC_CACHE_TTL_HOURS=24
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.85

# ===== Awareness 记忆服务（可选，需单独部署）=====
AWARENESS_MEMORY_ENABLED=false
AWARENESS_BASE_URL=http://localhost:37800
AWARENESS_MCP_PATH=/mcp
AWARENESS_TIMEOUT_SECONDS=0.25
AWARENESS_RECALL_LIMIT=5
AWARENESS_SOURCE=mooncare-backend

# ===== HTTP/2 与流式 =====
HTTP2_ENABLED=true
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_TIMEOUT_SECONDS=60
STREAMING_ENABLED=true
ENABLE_GZIP_COMPRESSION=true

# ===== 生产环境关键标志 =====
DEBUG=false
MEMORY_SYSTEM_ENABLED=true
