# MoonCARE local backend environment example.
# Copy to backend/.env for local development. Do not commit real secrets.

DATABASE_URL=sqlite:///./healthai.db

SECRET_KEY=local-dev-change-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local collaborator startup should be able to log in with the debug account.
# Production and public demos must set DEBUG=false and use a strong SECRET_KEY.
DEBUG=true
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_EMAIL_DELIVERY_MODE=log
AUTH_EMAIL_CODE_TTL_MINUTES=10
AUTH_EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5

# LLM provider configuration. For local startup, missing API keys should not
# block importing the backend; chat calls may fall back when provider calls fail.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=deepseek-ai/deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-3.5-turbo

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL_NAME=glm-5.1

VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=vllm-local
VLLM_MODEL_NAME=meta/llama-3.2-3b-instruct

ACCELERATED_LLM_BASE_URL=http://localhost:30000/v1
ACCELERATED_LLM_API_KEY=accelerated-local
ACCELERATED_LLM_MODEL_NAME=glm-5.1
ACCELERATED_LLM_ENGINE=openai-compatible

LLM_REQUEST_TIMEOUT_SECONDS=12
LLM_CONNECT_TIMEOUT_SECONDS=3
LLM_WRITE_TIMEOUT_SECONDS=8
LLM_POOL_TIMEOUT_SECONDS=2
CHAT_AGENT_REPLY_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=0
LLM_TRUST_ENV_PROXY=false

# Optional Redis semantic cache. Keep disabled for one-command local startup.
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=100
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_TTL_HOURS=24
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.85
SEMANTIC_CACHE_WARMUP_ENABLED=false
SEMANTIC_CACHE_WARMUP_ITEMS=3
SEMANTIC_CACHE_NAMESPACE=chat-agent-v1

# Optional Awareness Local memory. Keep disabled unless it is started separately.
AWARENESS_MEMORY_ENABLED=false
AWARENESS_BASE_URL=http://localhost:37800
AWARENESS_MCP_PATH=/mcp
AWARENESS_TIMEOUT_SECONDS=3
AWARENESS_RECALL_LIMIT=5
AWARENESS_SOURCE=mooncare-backend

HTTP2_ENABLED=true
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_TIMEOUT_SECONDS=60
STREAMING_ENABLED=true
FIRST_TOKEN_TIMEOUT_SECONDS=3
CONVERSATION_COMPACTION_USE_TIKTOKEN=false
ENABLE_GZIP_COMPRESSION=true
