# MoonCARE Android Capacitor API targets
#
# Copy one value into frontend/.env.local or your CI environment before building.
# Do not put API keys, SECRET_KEY, database URLs, or Railway tokens in Android env files.

# Railway HTTPS backend for remote Android testing.
VITE_API_BASE_URL=https://your-mooncare-backend.up.railway.app/api/v1
VITE_ENABLE_BIOMETRIC_DEMO=false
VITE_APP_UPDATE_CHANNEL=beta
VITE_APP_UPDATE_CHECK_URL=https://updates.example.com/api/v1/mobile/releases/android

# Android emulator to local backend.
# VITE_API_BASE_URL=http://10.0.2.2:8000/api/v1
# VITE_ENABLE_BIOMETRIC_DEMO=true
# VITE_APP_UPDATE_CHANNEL=beta
# VITE_APP_UPDATE_CHECK_URL=https://updates.example.com/api/v1/mobile/releases/android

# Physical Android device to LAN backend. Replace with your computer/server LAN IP.
# VITE_API_BASE_URL=http://192.168.1.100:8000/api/v1
# VITE_ENABLE_BIOMETRIC_DEMO=false
# VITE_APP_UPDATE_CHANNEL=beta
# VITE_APP_UPDATE_CHECK_URL=https://updates.example.com/api/v1/mobile/releases/android
