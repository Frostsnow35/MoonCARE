# MoonCARE server deployment environment template.
# Copy to .env on the Linux server before running docker compose.
# Do not commit real secrets, database passwords, or provider keys.

# Bind services to localhost. Nginx should be the only public entrypoint.
APP_BIND_ADDR=127.0.0.1
APP_PORT=8000
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_ADDR=127.0.0.1
REDIS_PORT=6379

# Server-side backup policy used by deploy/scripts/backup_postgres.sh.
BACKUP_DIR=/www/backup
BACKUP_RETENTION_DAYS=30

# Required database and auth secrets.
DB_PASSWORD=replace_with_strong_postgres_password
SECRET_KEY=replace_with_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Runtime mode. Keep DEBUG=false for server deployments.
DEBUG=false
RUN_DB_MIGRATIONS=false
MEMORY_SYSTEM_ENABLED=true

# Email verification delivery.
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_EMAIL_CODE_TTL_MINUTES=10
AUTH_EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5
AUTH_EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mooncare.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# LLM provider. Current server baseline uses NVIDIA.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=deepseek-ai/deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-3.5-turbo

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL_NAME=glm-5.1

VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_API_KEY=vllm-local
VLLM_MODEL_NAME=meta/llama-3.2-3b-instruct

ACCELERATED_LLM_BASE_URL=http://host.docker.internal:30000/v1
ACCELERATED_LLM_API_KEY=accelerated-local
ACCELERATED_LLM_MODEL_NAME=glm-5.1

# Timeouts. Keep chat bounded so timeout fallback stays effective.
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_WRITE_TIMEOUT_SECONDS=20
LLM_POOL_TIMEOUT_SECONDS=10
CHAT_AGENT_REPLY_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=0
LLM_TRUST_ENV_PROXY=false

# Redis infrastructure is available in Compose, but the semantic cache remains process-local.
REDIS_URL=redis://redis:6379
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_TTL_HOURS=24
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.85
SEMANTIC_CACHE_WARMUP_ENABLED=false
SEMANTIC_CACHE_WARMUP_ITEMS=3
SEMANTIC_CACHE_NAMESPACE=chat-agent-v1

# Android self-hosted update metadata. Use HTTPS before release rollout.
MOBILE_RELEASES_DIR=/srv/mooncare/mobile_releases
MOBILE_RELEASES_PUBLIC_BASE_URL=https://example.com

# HTTP and streaming behavior.
HTTP2_ENABLED=true
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_TIMEOUT_SECONDS=60
STREAMING_ENABLED=true
FIRST_TOKEN_TIMEOUT_SECONDS=20
ENABLE_GZIP_COMPRESSION=true
