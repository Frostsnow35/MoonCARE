# MoonCARE 环境配置示例

# 数据库配置
DATABASE_URL=sqlite:///./healthai.db

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM 提供商配置
# 可选值: nvidia, openai, vllm, accelerated, zai
LLM_PROVIDER=nvidia

# NVIDIA API 配置（当 LLM_PROVIDER=nvidia 时）
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL_NAME=z-ai/glm-5.1

# OpenAI API 配置（当 LLM_PROVIDER=openai 时）
OPENAI_API_KEY=your-openai-api-key
MODEL_NAME=gpt-3.5-turbo

# Z.AI/智谱 API 配置（当 LLM_PROVIDER=zai 时）
ZAI_API_KEY=your-zai-api-key
ZAI_MODEL_NAME=glm-5.1

# vLLM 本地部署配置
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=vllm-local
VLLM_MODEL_NAME=meta/llama-3.2-3b-instruct

# Redis 配置（语义缓存）
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=100

# 性能优化配置
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_HOURS=24
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.85

# Awareness Local 产品运行时记忆（可选功能，默认禁用）
# 如果需要启用长期记忆同步功能，需要先启动 Awareness daemon
# 设置 http://localhost:37800/mcp 可访问后，将 AWARENESS_MEMORY_ENABLED=true
# 不启用时系统将使用本地数据库存储记忆，功能不受影响
AWARENESS_MEMORY_ENABLED=false
AWARENESS_BASE_URL=http://localhost:37800
AWARENESS_MCP_PATH=/mcp
AWARENESS_TIMEOUT_SECONDS=0.25
AWARENESS_RECALL_LIMIT=5
AWARENESS_SOURCE=mooncare-backend

HTTP2_ENABLED=true
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_TIMEOUT_SECONDS=60

STREAMING_ENABLED=true
ENABLE_GZIP_COMPRESSION=true
