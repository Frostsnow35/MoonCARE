# MoonCARE Railway 部署环境变量示例
# 复制此文件为 .env.railway 并在 Railway 项目设置中填入

# 应用配置
APP_NAME=MoonCARE
DEBUG=false
APP_VERSION=1.0.0

# 安全配置（重要：生产环境请修改）
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 数据库配置
DATABASE_URL=sqlite:///./healthai.db

# LLM 提供商配置（选择其中一个）

# 方案1：NVIDIA API
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=z-ai/glm-5.1

# 方案2：OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key
# MODEL_NAME=gpt-3.5-turbo

# 方案3：Z.AI 智谱
# LLM_PROVIDER=zai
# ZAI_API_KEY=your-zai-api-key
# ZAI_MODEL_NAME=glm-5.1

# Awareness 记忆服务配置
# 设置为 true 以启用长期记忆功能（需要 Railway 付费版或单独部署）
AWARENESS_MEMORY_ENABLED=true
AWARENESS_BASE_URL=http://localhost:37800
AWARENESS_MCP_PATH=/mcp
AWARENESS_TIMEOUT_SECONDS=3.0
AWARENESS_RECALL_LIMIT=5
AWARENESS_SOURCE=mooncare-backend

# Redis 配置（语义缓存，可选）
REDIS_URL=redis://localhost:6379
SEMANTIC_CACHE_ENABLED=false

# HTTP/2 和连接优化
HTTP2_ENABLED=true
KEEP_ALIVE_ENABLED=true
STREAMING_ENABLED=true
ENABLE_GZIP_COMPRESSION=true

# 前端 API 地址（部署后填入 Railway 提供的 URL）
# API_BASE_URL=https://your-app-name.up.railway.app/api/v1
