{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksJson": {}
  },
  "deploy": {
    "numReplicas": 1,
    "sleep": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "start": {
    "command": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
  },
  "environments": {
    "node": {
      "build": {
        "command": "cd frontend && npm install && npm run build"
      },
      "start": {
        "command": "cd frontend && npm run preview -- --port ${PORT:-3000}"
      }
    }
  }
}
