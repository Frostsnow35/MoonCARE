{
  "name": "mooncare-awareness",
  "version": "1.0.0",
  "description": "MoonCARE with Awareness Memory Service",
  "scripts": {
    "start:awareness": "npx --yes @awareness-sdk/local@latest start",
    "start:backend": "cd ../backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "start:frontend": "cd ../frontend && npm run dev",
    "start:all": "npm run start:awareness && npm run start:backend && npm run start:frontend",
    "dev": "npm run start:awareness"
  },
  "dependencies": {
    "@awareness-sdk/local": "latest"
  }
}
