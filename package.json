{
  "name": "MoonCARE",
  "version": "1.0.0",
  "description": "智能情绪管理平台 - 经期追踪、PMS筛查、AI陪伴",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run preview",
    "railway:up": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}",
    "awareness:start": "npx --yes @awareness-sdk/local@latest start"
  },
  "dependencies": {
    "@awareness-sdk/local": "^0.11.6",
    "concurrently": "^8.2.0"
  }
}
